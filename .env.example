# Environment variables in the shell override this file.
BACKEND_PORT=8000
FRONTEND_PORT=5173
CONNECTOR_URL=http://127.0.0.1:8301
CONNECTOR_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Optional authentication sent to Connector; never put provider keys in the UI.
CONNECTOR_API_KEY=
# Empty values should be removed or replaced with absolute paths.
# STUDIO_DATA_DIR=/absolute/path/to/studio-data
# WORKSPACE_ROOT=/absolute/path/to/projects
# Any folder permitted by the backend account's OS permissions (also the default).
FILE_BROWSER_ROOTS=*
# Optional restriction: semicolon-separated on Windows, colon-separated on Linux/macOS.
# FILE_BROWSER_ROOTS=C:\Users\your-user;D:\Work
JOB_TTL_SECONDS=86400
